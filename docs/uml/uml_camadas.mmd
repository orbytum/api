  %% ======================= Armazenamento de arquivos =======================
  class ArquivoStorage {
    <<interface>>
    +salvar(String, MultipartFile) ArquivoArmazenado
    +baixar(String, StorageProvider) byte[]
    +excluir(String, StorageProvider) void
    +disponivel(StorageProvider) boolean
  }
  class FallbackStorageService {
    +salvar(String, MultipartFile) ArquivoArmazenado
    +baixar(String, StorageProvider) byte[]
    +excluir(String, StorageProvider) void
    +disponivel(StorageProvider) boolean
  }
  class S3StorageService {
    +isConfigured() boolean
    +uploadFile(String, MultipartFile) String
    +downloadFile(String) byte[]
    +deleteFile(String) void
    +generatePresignedGetUrl(String, Duration) String
  }
  class DatabaseStorageService {
    +salvar(String, MultipartFile) ArquivoArmazenado
    +baixar(String) byte[]
    +excluir(String) void
  }
  class ArquivoArmazenado { <<record>> }
  class ArquivoDownload { <<record>> }

